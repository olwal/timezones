**/.git
**/.DS_Store
**/node_modules
.gitignore
.assetsignore
.nojekyll
wrangler.jsonc
README.md
docs/
# icons/, manifest.webmanifest, favicon.svg and sw.js are part of the site and
# must stay deployed.
